{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist-tests",
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES2020",
    "declaration": false,
    "emitDeclarationOnly": false,
    "types": ["node"],
    "esModuleInterop": true,
    "jsx": "react-jsx"
  },
  "include": ["tests/**/*.ts", "tests/**/*.d.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/stories/**/*"]
}
