### Client Components
```typescript
// components/portfolio/InteractiveChart.tsx
'use client'

import { useState, useEffect } from 'react'
import { LineChart, Line, XAxis, YAxis, ResponsiveContainer } from 'recharts'
import useSWR from 'swr'

export function InteractiveChart() {
  const { data, error } = useSWR('/api/portfolio/history', fetcher)
  const [timeRange, setTimeRange] = useState('1M')

  if (error) return <div>Error loading chart</div>
  if (!data) return <ChartSkeleton />

  return (
    <div className="bg-white rounded-xl p-6 shadow-card">
      <div className="flex justify-between items-center mb-4">
        <h3 className="text-lg font-semibold">Portfolio Performance</h3>
        <TimeRangeSelector value={timeRange} onChange={setTimeRange} />
      </div>
      <ResponsiveContainer width="100%" height={300}>
        <LineChart data={data}>
          <XAxis dataKey="date" />
          <YAxis />
          <Line type="monotone" dataKey="value" stroke="var(--color-accent-primary)" />
        </LineChart>
      </ResponsiveContainer>
    </div>
  )
}
```

## State Management Patterns

### Zustand Store
```typescript
// stores/portfolioStore.ts
import { create } from 'zustand'
import { devtools } from 'zustand/middleware'

interface PortfolioState {
  selectedTimeRange: string
  selectedAsset: string | null
  setTimeRange: (range: string) => void
  setSelectedAsset: (asset: string | null) => void
}

export const usePortfolioStore = create<PortfolioState>()(
  devtools(
    (set) => ({
      selectedTimeRange: '1M',
      selectedAsset: null,
      setTimeRange: (range) => set({ selectedTimeRange: range }),
      setSelectedAsset: (asset) => set({ selectedAsset: asset }),
    }),
    { name: 'portfolio-store' }
  )
)
```

### SWR Data Fetching
```typescript
// hooks/usePortfolio.ts
import useSWR from 'swr'
import { PortfolioData } from '@/types/portfolio'

const fetcher = (url: string) => fetch(url).then(res => res.json())

export function usePortfolio() {
  const { data, error, isLoading, mutate } = useSWR<PortfolioData>(
    '/api/v1/portfolio',
    fetcher,
    {
      refreshInterval: 30000, // Refresh every 30 seconds
      revalidateOnFocus: true,
    }
  )

  return {
    portfolio: data,
    isLoading,
    error,
    refresh: mutate,
  }
}
```

## Form Handling Patterns

### React Hook Form with Zod
```typescript
// components/forms/AssetForm.tsx
'use client'

import { useForm } from 'react-hook-form'
import { zodResolver } from '@hookform/resolvers/zod'
import { z } from 'zod'

const assetSchema = z.object({
  symbol: z.string().min(1, 'Symbol is required'),
  quantity: z.number().positive('Quantity must be positive'),
  purchasePrice: z.number().positive('Purchase price must be positive'),
})

type AssetFormData = z.infer<typeof assetSchema>

export function AssetForm() {
  const {
    register,
    handleSubmit,
    formState: { errors, isSubmitting },
  } = useForm<AssetFormData>({
    resolver: zodResolver(assetSchema),
  })

  const onSubmit = async (data: AssetFormData) => {
    try {
      await fetch('/api/v1/assets', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      })
    } catch (error) {
      console.error('Failed to add asset:', error)
    }
  }

  return (
    <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
      <div>
        <label className="block text-sm font-medium mb-1">Symbol</label>
        <input
          {...register('symbol')}
          className="w-full px-3 py-2 border border-border rounded-md"
        />
        {errors.symbol && (
          <p className="text-destructive text-sm mt-1">{errors.symbol.message}</p>
        )}
      </div>
      {/* More form fields */}
      <button
        type="submit"
        disabled={isSubmitting}
        className="w-full bg-primary text-primary-foreground py-2 px-4 rounded-md hover:bg-primary/90"
      >
        {isSubmitting ? 'Adding...' : 'Add Asset'}
      </button>
    </form>
  )
}
```

