# ----------------------------------------------------------------------------
# Application defaults
# Copy this file to `.env.staging` / `.env.production` for use with the Makefile and CI helpers.
# ----------------------------------------------------------------------------
APP_NAME=portfolio-dashboard
NODE_ENV=production
ENVIRONMENT=staging
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Frontend (Vercel) configuration
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.staging.example.com
NEXT_PUBLIC_SENTRY_DSN=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# Optional aliases to simplify rollbacks
VERCEL_ROLLBACK_TARGET=
VERCEL_ROLLBACK_TARGET_STAGING=
VERCEL_ROLLBACK_TARGET_PRODUCTION=

# ----------------------------------------------------------------------------
# Backend API configuration
# ----------------------------------------------------------------------------
API_BASE_URL=https://api.staging.example.com
API_HEALTH_URL=https://api.staging.example.com/health
DB_HEALTH_URL=https://api.staging.example.com/health/db
SECRET_KEY=replace-me
ALLOWED_ORIGINS=https://app.staging.example.com

# ----------------------------------------------------------------------------
# Database & cache
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://app:password@db.staging.example.com:5432/app
REDIS_URL=redis://cache.staging.example.com:6379/0

# ----------------------------------------------------------------------------
# AWS ECS/Fargate deployment
# ----------------------------------------------------------------------------
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
ECS_CLUSTER_NAME=portfolio-dashboard-staging
ECS_SERVICE_NAME=portfolio-dashboard-backend
ECS_TASK_FAMILY=portfolio-dashboard-staging
ECS_DESIRED_COUNT=2
TASK_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/portfolio-dashboard-ecs-execution
TASK_ROLE_ARN=arn:aws:iam::123456789012:role/portfolio-dashboard-ecs-task
BACKEND_IMAGE=ghcr.io/org/portfolio-dashboard-backend:sha-<commit>

# ----------------------------------------------------------------------------
# GitHub Actions secrets guidance
# ----------------------------------------------------------------------------
# Configure the following secrets/variables per GitHub environment:
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
#   AWS_ECS_EXECUTION_ROLE_ARN, AWS_ECS_TASK_ROLE_ARN
#   FRONTEND_URL, API_HEALTH_URL, DB_HEALTH_URL
#   VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID, VERCEL_ROLLBACK_TARGET*
# Values in this template are safe defaults and not real credentials.
