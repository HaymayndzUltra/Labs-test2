# Phase 2 Execution Environment Variables
# PropWise Project Generation Configuration

# Project Metadata
NAME=PropWise
SLUG=client01saas
INDUSTRY=saas
PROJECT_TYPE=fullstack

# Technology Stack
FE=nextjs
BE=fastapi
DB=postgres
AUTH=jwt
DEPLOY=docker

# Output Configuration
OUTPUT_ROOT=/home/haymayndz/Labs-test2/output
PROJECT_DIR=/home/haymayndz/Labs-test2/docs/briefs/client01saas/phase1_artifacts

# Execution Flags
FORCE_OUTPUT=true
WORKERS=8

# PropWise Specific Configuration
MULTI_TENANT=true
TENANCY_MODEL=column
BILLING=none
NOTIFICATIONS=true
AI_FEATURE=monthly_summary
AI_LLM_REQUIRED=false
AUDIT_TRAIL=true
OBSERVABILITY=basic

# Quality Gates
COVERAGE_THRESHOLD=0.80
SECURITY_FAIL_ON=high
PERF_TARGET_P95_MS=300
BUILD_PROFILE=production

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@db:5432/propwise
JWT_SECRET=dev_secret
CORS_ORIGINS=http://localhost:3000
ENABLE_AI=false
TENANCY_MODEL=column
