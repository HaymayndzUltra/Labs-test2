    "@visx/gradient": "^3.7.0",
    "@visx/group": "^3.7.0",
    "@visx/scale": "^3.7.0",
    "@visx/shape": "^3.7.0",
    "@visx/tooltip": "^3.7.0",
    "@visx/zoom": "^3.7.0",
    "@tanstack/react-query": "^5.29.2",
